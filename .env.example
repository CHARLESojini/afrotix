# Copy to .env and fill in. Never commit the real .env.

# --- Phase 2: saga service databases (Postgres, one per service) ---
INVENTORY_DB_URL=postgresql://afrotix:afrotix@localhost:5433/inventory
PAYMENTS_DB_URL=postgresql://afrotix:afrotix@localhost:5434/payments
TICKETING_DB_URL=postgresql://afrotix:afrotix@localhost:5435/ticketing

# --- Phase 2: saga simulation knobs (drive the compensation paths) ---
PAYMENT_FAILURE_RATE=0.12   # share of charges that randomly decline -> release hold
SAGA_CANCEL_RATE=0.05       # share of fans who cancel after issue -> refund + void

# --- Phase 3: warehouse selection ---
WAREHOUSE=duckdb                                   # duckdb (default) | snowflake
DUCKDB_PATH=data/warehouse/afrotix.duckdb
BRONZE_SCHEMA=bronze

# --- Phase 3/4: Snowflake (flip WAREHOUSE=snowflake to use these) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=AFROTIX_WH
SNOWFLAKE_DATABASE=AFROTIX
SNOWFLAKE_PRIVATE_KEY_PATH=   # key-pair (.p8) auth, same pattern as the Airbyte connection
# SNOWFLAKE_PASSWORD=         # used only if no private key path is set
